{
    "name": "create-playcanvas",
    "version": "0.9.0",
    "description": "Scaffold a PlayCanvas project",
    "keywords": [
        "playcanvas",
        "create",
        "scaffold",
        "template",
        "vite",
        "react",
        "web-components",
        "typescript",
        "webgl",
        "webgpu",
        "game",
        "3d"
    ],
    "homepage": "https://github.com/playcanvas/create-playcanvas#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/playcanvas/create-playcanvas.git"
    },
    "license": "MIT",
    "author": "PlayCanvas <support@playcanvas.com>",
    "type": "module",
    "bin": {
        "create-playcanvas": "dist/index.mjs"
    },
    "files": [
        "skills",
        "templates",
        "dist"
    ],
    "scripts": {
        "build": "unbuild",
        "dev": "unbuild --stub",
        "fmt": "prettier --check . --ignore-path .prettierignore.tool",
        "fmt:fix": "prettier --write . --ignore-path .prettierignore.tool",
        "lint": "eslint . --no-config-lookup --config eslint.config.tool.mjs",
        "lint:fix": "eslint . --no-config-lookup --config eslint.config.tool.mjs --fix",
        "typecheck": "tsc --noEmit -p tsconfig.tool.json",
        "app:build": "vite build",
        "app:dev": "vite",
        "app:fmt": "prettier --check . --config prettier.config.app.mjs",
        "app:fmt:fix": "prettier --write . --config prettier.config.app.mjs",
        "app:lint": "eslint . --config eslint.config.app.mjs",
        "app:lint:fix": "eslint . --config eslint.config.app.mjs --fix",
        "app:start": "vite preview",
        "app:typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "playcanvas": "^2.23.0"
    },
    "devDependencies": {
        "@clack/prompts": "^1.8.1",
        "@playcanvas/eslint-config": "3.0.0-beta.8",
        "@types/node": "22.20.4",
        "eslint": "^9.39.5",
        "mri": "^1.2.0",
        "picocolors": "^1.1.1",
        "prettier": "^3.9.9",
        "typescript": "~6.0.3",
        "unbuild": "^3.6.1",
        "vite": "^8.3.1"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
